# Backend .env.example
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development

# CORS — the URL of the frontend during development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Phase 2)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://soc_lite_user:YOUR_STRONG_PASSWORD@localhost:5432/soc_lite_db?schema=public

# JWT signing secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# JWT expiry duration (Phase 2)
JWT_EXPIRES_IN=8h

# Optional Threat Intelligence Provider API Keys (Phase 9)
# If left empty, providers safely report 'NOT_CONFIGURED' without breaking queries.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
